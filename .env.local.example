# ---------------------------------------------------------------------------
# Supabase — copie de: Supabase Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Chave pública, usada no browser (respeita RLS).
# Formato novo: sb_publishable_...   |   formato antigo: eyJhbGci... (JWT anon)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo de service role — NUNCA exponha ao cliente.
# ATENÇÃO: precisa ter "role": "service_role" no payload do JWT.
# Se for colada a chave anon, operações privilegiadas falham com
# "new row violates row-level security policy".
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# IA — extração do edital verticalizado (opcional)
#
# Crie sua chave gratuita em https://aistudio.google.com/apikey
# Sem a chave, a extração por IA fica desativada e o editor manual continua
# funcionando normalmente.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Modelo do Gemini. Use um que aceite "structured output".
# Padrão do código: gemini-flash-lite-latest
LLM_MODEL=gemini-flash-lite-latest
